<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<TextView
    android:id="@+id/txtThongTinSV"
    android:text="Trương Ngọc Quý - msv:2415053122235 - TLTTD01"
    android:textSize="16sp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"/>

<EditText
    android:id="@+id/edtTenCongViec"
    android:hint="Nhập tên công việc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<EditText
    android:id="@+id/edtMoTaCongViec"
    android:hint="Nhập mô tả công việc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<Button
    android:id="@+id/btnTaoCongViec"
    android:text="Tạo công việc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<Button
    android:id="@+id/btnXemDanhSach"
    android:text="Xem danh sách công việc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>
</LinearLayout>
